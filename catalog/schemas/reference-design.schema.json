{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechaflow-cad.example/schemas/reference-design.schema.json",
  "title": "MechaFlow CAD reference design catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "summary",
    "source",
    "license",
    "openness",
    "assets",
    "engineering_intent",
    "integration_notes",
    "review"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "reference-design.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "retrieved_at"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "repository": { "type": "string" },
        "retrieved_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "upstream_license_url": { "type": "string" },
        "upstream_docs_url": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "compatibility", "evidence", "cautions"],
      "properties": {
        "declared": { "type": "string" },
        "spdx": { "type": "string" },
        "compatibility": {
          "type": "string",
          "enum": ["appears-compatible", "conditional", "not-compatible", "uncertain"]
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "cautions": { "type": "array", "items": { "type": "string" } },
        "review_required_before_import": { "type": "boolean", "default": true }
      }
    },
    "openness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_files_available", "commercial_use_known", "redistribution_known"],
      "properties": {
        "design_files_available": { "type": "boolean" },
        "commercial_use_known": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "redistribution_known": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cad", "electronics", "bom", "documentation"],
      "properties": {
        "cad": { "$ref": "#/$defs/assetList" },
        "electronics": { "$ref": "#/$defs/assetList" },
        "bom": { "$ref": "#/$defs/assetList" },
        "documentation": { "$ref": "#/$defs/assetList" },
        "media": { "$ref": "#/$defs/assetList" }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure_confidence": { "type": "string", "enum": ["high", "medium", "low", "unknown"] },
        "known_subassemblies": { "type": "array", "items": { "type": "string" } },
        "exploded_view_seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "type": "string", "enum": ["manual", "axis-spread", "assembly-tree", "unknown"] },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "engineering_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["example_tasks", "capability_rating_ids", "primary_material_ids", "manufacturing_method_ids"],
      "properties": {
        "example_tasks": { "type": "array", "items": { "type": "string" } },
        "capability_rating_ids": { "type": "array", "items": { "type": "string" } },
        "primary_material_ids": { "type": "array", "items": { "type": "string" } },
        "manufacturing_method_ids": { "type": "array", "items": { "type": "string" } },
        "electronics_awareness": { "type": "string", "enum": ["none", "bom-only", "pcb", "wire-harness", "unknown"] }
      }
    },
    "integration_notes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freecad": { "type": "array", "items": { "type": "string" } },
        "fea": { "type": "array", "items": { "type": "string" } },
        "kicad_wireviz": { "type": "array", "items": { "type": "string" } },
        "ros_urdf": { "type": "array", "items": { "type": "string" } },
        "manufacturing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "next_actions"],
      "properties": {
        "status": { "type": "string", "enum": ["seed", "needs-license-review", "ready-for-import", "blocked"] },
        "reviewed_by": { "type": "string" },
        "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "next_actions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "assetList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "format", "path_or_url", "availability", "license_inherits"],
        "properties": {
          "kind": { "type": "string" },
          "format": { "type": "string" },
          "path_or_url": { "type": "string" },
          "availability": { "type": "string", "enum": ["available", "referenced", "unknown", "missing"] },
          "license_inherits": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
