{
  "name": "mechaflow-cad",
  "productName": "MechaFlow CAD",
  "version": "0.1.0",
  "description": "Local desktop-openable MVP demo for the MechaFlow CAD engineering cockpit.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node scripts/desktop-dev.mjs",
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "desktop:open": "node scripts/desktop-dev.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:macos:shortcut": "node scripts/install-macos-launcher.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src --react-plugin --deny-warnings",
    "smoke": "node scripts/smoke-local.mjs",
    "captain:smoke": "node scripts/captain-demo-smoke.mjs",
    "ports:find": "node scripts/find-ports.mjs",
    "mock:api": "node scripts/mock-backend.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
